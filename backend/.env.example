# Database Configuration
PGHOST=localhost
PGUSER=postgres
PGPASSWORD=your_secure_password_here
PGDATABASE=postgres
PGPORT=5432

# Server Configuration
PORT=5000
CORS_ORIGINS=http://localhost:3000

# JWT Configuration (REQUIRED)
# Generate a secure random key using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters
JWT_EXPIRES_IN=24h

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=your-email@gmail.com
FROM_NAME=ProductGuard Support

# Optional: Additional email settings
ENABLE_EMAIL_NOTIFICATIONS=true

# Blockchain Configuration (Optional)
CONTRACT_ADDRESS=
CHAIN_INDEXER_ENABLED=false
CHAIN_INDEXER_RPC_URL=http://127.0.0.1:8545
CHAIN_INDEXER_BLOCK_CHUNK=1000